{
  "manifest_version": 3,
  "name": "치지직 Caps Lock 이모티콘",
  "description": "치지직 검색·채팅·광고 편의, 치지직·숲 목록 미리보기, 모든 웹사이트의 영상 속도와 프레임 이동을 지원합니다.",
  "version": "0.7.0",
  "background": { "service_worker": "media-background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "치지직 이모티콘 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["page-bridge.js", "quality-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["quality-settings.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["tools-core.js", "content.js", "player-tools.js", "ad-skip.js", "site-tools.js", "channel-data.js", "channel-tools.js", "chzzk-quality.js", "vendor/hls.min.js", "list-preview.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.sooplive.com/*", "https://*.sooplive.co.kr/*", "https://sooplive.com/*", "https://sooplive.co.kr/*"],
      "js": ["preview-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.sooplive.com/*", "https://*.sooplive.co.kr/*", "https://sooplive.com/*", "https://sooplive.co.kr/*"],
      "js": ["list-preview.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-speed.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
