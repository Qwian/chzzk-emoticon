{
  "manifest_version": 3,
  "name": "치지직 Caps Lock 이모티콘",
  "description": "치지직 이모티콘 단축키, 한영 검색, 즐겨찾기, 실시간 따라잡기와 광고 재생 편의를 제공합니다.",
  "version": "0.4.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "치지직 이모티콘 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["tools-core.js", "content.js", "player-tools.js", "site-tools.js"],
      "run_at": "document_idle"
    }
  ]
}
